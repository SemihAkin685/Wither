{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wither",
  "mainBinaryName": "wither",
  "version": "0.1.0",
  "identifier": "dev.wither.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wither",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false,
        "resizable": true,
        "backgroundColor": "#121116"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://raw.githubusercontent.com; img-src 'self' data: blob: asset:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "The IDE for Minecraft Bedrock addons",
    "longDescription": "Wither is a native desktop IDE dedicated to Minecraft Bedrock Edition addon development.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
